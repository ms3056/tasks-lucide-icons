{
  "name": "tasks-lucide-icons",
  "version": "2.0.0",
  "description": "Replaces Tasks plugin emojis and custom regex patterns with native Lucide SVG icons.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "tasks",
    "lucide",
    "icons",
    "regex"
  ],
  "author": "Mike Stamper",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@types/node": "^20.0.0",
    "esbuild": "0.21.5",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  }
}